# Dependencies — installed from the host app, never committed.
node_modules/

# Plugin output. Both files live under $DSH_HOME/key-panel/, which is outside
# this repo; these entries only guard against a stray local copy.
key-panel/
keys.json
usage.jsonl
*.local.json

# Never commit npm credentials. A .npmrc here pointing at a private registry
# would be published to a public repo — that is the whole reason the internal
# registry is published with a command-line --registry instead. Ignoring it
# costs nothing and removes the failure mode.
.npmrc

# Pack output. `npm pack` leaves a tarball behind; it must never be committed.
*.tgz

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and coverage
*.log
npm-debug.log*
coverage/

# Local backups
*.bak
*.orig

# One-off local maintenance scripts. These point at machine-specific paths
# (this operator's profile directory) and are not part of the published plugin.
# The repo's own `files` list already excludes them; this keeps `git status`
# honest about what is actually pending.
update-profile-keypanel.mjs
upgrade-profile-pin.ps1
